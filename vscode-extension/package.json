{
  "name": "mdpreview-vscode",
  "displayName": "MDpreview",
  "description": "Rendered markdown preview with line-anchored comments, right inside VSCode.",
  "version": "0.1.6",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "//activationEvents": "onStartupFinished is required by takeover.js: it has to be watching tab changes BEFORE something opens a .md as plain text, and the customEditors contribution alone only activates us once our own editor opens.",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "vendor": "node scripts/vendor-shared.js",
    "package": "npm run vendor && vsce package --allow-missing-repository",
    "vscode:prepublish": "npm run vendor"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^12.0.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdpreview.preview",
        "displayName": "MDpreview",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "mdpreview.openAsText",
        "title": "MDpreview: Mở file này dưới dạng văn bản thô",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdpreview.openAsPreview",
        "title": "MDpreview: Mở file này bằng MDpreview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdpreview.openAsText",
          "when": "resourceExtname == .md && activeCustomEditorId == mdpreview.preview",
          "group": "navigation@99"
        },
        {
          "command": "mdpreview.openAsPreview",
          "when": "resourceExtname == .md && activeCustomEditorId != mdpreview.preview",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "MDpreview",
      "properties": {
        "mdpreview.takeoverTextEditors": {
          "type": "string",
          "enum": [
            "auto",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Mở lại mọi tab .md dạng text editor bằng MDpreview.",
            "Không can thiệp — tôn trọng editor mà VSCode chọn."
          ],
          "description": "Tự giành lại tab khi một extension khác (ví dụ Claude Code) mở file .md bằng text editor."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "mermaid": "^10.9.8"
  }
}
